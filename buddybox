#!/bin/bash

# Get the path to me
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

source $SCRIPT_DIR/.env

# Add the logger function
source $SCRIPT_DIR/logger

# Ensure runtime directory is set for audio services
export XDG_RUNTIME_DIR=/run/user/$(id -u)

# Cleanup function to kill background processes on exit
cleanup() {
    log "Shutting down..."
    sudo killall -9 mpv 2>/dev/null
    kill $(jobs -p) 2>/dev/null
    exit 0
}

# Trap signals for a clean exit
trap cleanup SIGINT SIGTERM

# MAIN

# Clean up any stuck mpv processes
sudo killall -9 mpv 2>/dev/null
sleep 2

# Mount USB Drive
if [[ -b /dev/sda1 ]]; then
    if ! mountpoint -q "$MUSIC_DIR"; then
        mkdir -p "$MUSIC_DIR"
        mount -o defaults /dev/sda1 "$MUSIC_DIR"
    fi
else
    log "USB drive not found, exiting"
    exit 1
fi

# Audio Hardware Detection
# This likely needs to be adjusted for different USB speakers
if aplay -l | grep -q "\[USB2.0 Device\]"; then
    log "Output Device: USB Speaker"
    AUDIO_CARD="Device"
    MPV_DEVICE="alsa/plughw:CARD=Device"
    MIXER_CONTROL="PCM"
    DEFAULT_VOLUME=40
else
    log "Output Device: Headphones"
    AUDIO_CARD="Headphones"
    MPV_DEVICE="alsa/plughw:CARD=Headphones"
    MIXER_CONTROL="PCM"
    DEFAULT_VOLUME=85
fi

# Record the info for other scripts to use
cat << EOF > "$SCRIPT_DIR/audio-device"
AUDIO_CARD="$AUDIO_CARD"
MPV_DEVICE="MPV_DEVICE"
MIXER_CONTROL="$MIXER_CONTROL"
DEFAULT_VOLUME=$DEFAULT_VOLUME
EOF

if [ -f "$TRACKFILE" ]; then
    start_track=$(cat "$TRACKFILE" | tr -d -c '0-9')
    log "Track file found, resuming playback at item $(echo $start_track+1 | bc)."
else
    log "No track file found, generating fresh playlist..."
    start_track=0
    find "$MUSIC_DIR" -type f \( -iname "*.mp3" -o -iname "*.m4a" \) ! -path "*/.*" ! -name "._*" | sort -R > "$PLAYLIST"
    log "Playlist generation complete."
fi

#Unmute and set volume to 0%
amixer -c "$AUDIO_CARD" sset "$MIXER_CONTROL" 0% unmute -M > /dev/null 2>&1

# Start mpv in background
log "Launching mpv..."
# --no-video prevents it from looking for a display
# --gapless-audio=yes ensures smooth transitions
# --msg-level=ao/pipewire=no stops the config file errors
(mpv --audio-device="$MPV_DEVICE" \
     --no-video \
     --really-quiet \
     --gapless-audio=yes \
     --msg-level=ao/pipewire=no \
     --input-ipc-server="$SOCKET" \
     --playlist="$PLAYLIST" \
     --playlist-start="$start_track" \
     --loop-playlist=inf) 2>&1 &

# Wait for mpv socket to become responsive
MAX_RETRIES=20
COUNT=0
log "Waiting for mpv socket to initialize..."
while [ $COUNT -lt $MAX_RETRIES ]; do
    # Try to get the 'pause' property as a 'ping'
    if echo '{ "command": ["get_property", "pause"] }' | socat - "$SOCKET" 2>/dev/null | grep -q "data"; then
        break
    fi
    sleep 0.5
    ((COUNT++))
    if [ $COUNT -eq $MAX_RETRIES ]; then
        log "Error: mpv socket failed to initialize in time."
        exit 1
    fi
done

# If mpv is playing and lockout is enabled then pause, otherwise fade in
if [ -f "$LOCKFILE" ]; then
    log "Playback locked out, pausing after mpv restart."
    echo '{ "command": ["set_property", "pause", true] }' | socat - "$SOCKET" > /dev/null 2>&1
    log "Setting volume to $DEFAULT_VOLUME."
    amixer -c "$AUDIO_CARD" sset "$MIXER_CONTROL" $DEFAULT_VOLUME% unmute -M > /dev/null 2>&1
else
    log "Starting playback..."
    . $SCRIPT_DIR/bb-fade in 10
fi

# Keep script running to maintain the background process
wait
