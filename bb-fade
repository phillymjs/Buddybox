#!/bin/bash

# USAGE:
# To fade out the music: bb-fade out 60 -> fades the music out over 10 seconds
# To fade in the music: bb-fade in 60 -> fades the music in over 10 seconds

# Get the path to me
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

source $SCRIPT_DIR/.env
source $SCRIPT_DIR/logger

# Use the first argument if it exists, otherwise default to 60
DIRECTION=$1
DURATION=${2:-60}

STEPS_PER_SECOND=10

# Get paused status
PAUSED=$(echo '{ "command": ["get_property", "pause"] }' | socat - "$SOCKET" | jq '.data')

source $SCRIPT_DIR/audio-device
if [ "$DIRECTION" = "in" ]; then
    VOLUME=$DEFAULT_VOLUME
else
    VOLUME=$(amixer -c "$AUDIO_CARD" -M sget "$MIXER_CONTROL" | grep -Po '\[\d+%\]' | head -1 | tr -d '[]%')
fi

# Calculate total steps based on duration
TOTAL_STEPS=$(echo "$DURATION * $STEPS_PER_SECOND" | bc)
# Calculate how much volume to change per step (Initial Volume / Total Steps)
VOL_STEP=$(echo "scale=4; $VOLUME / $TOTAL_STEPS" | bc)
# Calculate sleep interval in seconds
SLEEP_INTERVAL=$(echo "scale=4; 1 / $STEPS_PER_SECOND" | bc)

log "Starting fade-$DIRECTION, duration is $DURATION seconds..."

# Capture start time in nanoseconds for drift correction
START_TIME=$(date +%s%N)

if [ "$DIRECTION" = "out" ]; then

    # ----- FADE OUT -----
    # Start fading out music
    CURRENT_VOL=$VOLUME
    for (( i=0; i<TOTAL_STEPS; i++ )); do
        CURRENT_VOL=$(echo "scale=4; $CURRENT_VOL - $VOL_STEP" | bc)
        amixer -q -c "$AUDIO_CARD" sset "$MIXER_CONTROL" "${CURRENT_VOL%.*}%" -M

        # Drift Correction
        EXPECTED_END=$(echo "$START_TIME + (($i + 1) * $SLEEP_INTERVAL * 1000000000)" | bc)
        NOW=$(date +%s%N)
        SLEEP_NEEDED=$(echo "scale=9; ($EXPECTED_END - $NOW) / 1000000000" | bc)
        if (( $(echo "$SLEEP_NEEDED > 0" | bc -l) )); then sleep $SLEEP_NEEDED; fi
    done

    # Mute playback device for good measure
    amixer -q -c "$AUDIO_CARD" sset "$MIXER_CONTROL" 0% mute -M > /dev/null 2>&1

    # Ensure we are actually playing before sending pause command
    if [ "$PAUSED" = "false" ]; then
        echo '{ "command": ["cycle", "pause"] }' | socat - "$SOCKET" > /dev/null
    fi

elif [ "$DIRECTION" = "in" ]; then

    # ----- FADE IN -----
    # Ensure playback device is unmuted and starting at 0
    amixer -q -c "$AUDIO_CARD" sset "$MIXER_CONTROL" 0% unmute -M > /dev/null 2>&1

    # Ensure we are actually paused before sending resume command
    if [ "$PAUSED" = "true" ]; then
        echo '{ "command": ["cycle", "pause"] }' | socat - "$SOCKET" > /dev/null
    fi

    # Start fading in music
    CURRENT_VOL=0
    for (( i=0; i<TOTAL_STEPS; i++ )); do
        CURRENT_VOL=$(echo "scale=4; $CURRENT_VOL + $VOL_STEP" | bc)
        amixer -q -c "$AUDIO_CARD" sset "$MIXER_CONTROL" "${CURRENT_VOL%.*}%" -M

        # Drift Correction
        EXPECTED_END=$(echo "$START_TIME + (($i + 1) * $SLEEP_INTERVAL * 1000000000)" | bc)
        NOW=$(date +%s%N)
        SLEEP_NEEDED=$(echo "scale=9; ($EXPECTED_END - $NOW) / 1000000000" | bc)
        if (( $(echo "$SLEEP_NEEDED > 0" | bc -l) )); then sleep $SLEEP_NEEDED; fi
    done

    # Final adjustment to ensure we hit exactly the DEFAULT_VOLUME
    amixer -q -c "$AUDIO_CARD" sset "$MIXER_CONTROL" "$DEFAULT_VOLUME%" -M

fi

log "Fade-$DIRECTION complete."
