#!/bin/sh

SOCKET="/tmp/mpv-socket"

# Audio Hardware Detection
if aplay -l | grep -q "\[USB2.0 Device\]"; then
    AUDIO_CARD="Device"
    MIXER_CONTROL="PCM"
    FADE_TARGET=40
else
    AUDIO_CARD="Headphones"
    MIXER_CONTROL="PCM"
    FADE_TARGET=85
fi

# Ensure volume is at the target level and unmuted
amixer -q -c "$AUDIO_CARD" sset "$MIXER_CONTROL" ${FADE_TARGET}% unmute -M > /dev/null 2>&1

# Toggle pause via mpv socket
echo '{ "command": ["cycle", "pause"] }' | socat - "${SOCKET}" > /dev/null
